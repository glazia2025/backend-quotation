QUOTATION_PDF_WARMUP_DELAY_MS=1200
QUOTATION_PDF_WORKER_POLL_MS=1000
QUOTATION_PDF_WORKER_LEASE_MS=30000
QUOTATION_PDF_JOB_STALE_MS=600000
